# Copy this file to .env and edit as needed.

# ---- Ollama ----
OLLAMA_HOST=http://127.0.0.1:11434

# Models. These are matched against what you actually have installed,
# so a partial name like "qwen2.5-coder" is fine.
VOV_CHAT_MODEL=qwen2.5:3b
VOV_FAST_MODEL=qwen2.5-coder:7b
VOV_POWERFUL_MODEL=qwen2.5-coder:14b
VOV_VISION_MODEL=llava:7b

VOV_TEMPERATURE=0.7
VOV_TOP_P=0.9
VOV_NUM_CTX=8192

# ---- Server ----
VOV_HOST=127.0.0.1
VOV_PORT=8001
VOV_CORS_ORIGINS=*

# ---- Limits ----
VOV_MAX_CONTEXT_FILES=25
VOV_MAX_FILE_CHARS=12000
VOV_MAX_HISTORY_TURNS=20
VOV_MAX_FIX_ATTEMPTS=4
